+def test_delete_fence_waits_for_in_flight_device_operation(monkeypatch):
+    async def scenario():
+        monkeypatch.setattr(scheduler, "_deleted_devices", set())
+        monkeypatch.setattr(scheduler, "_tasks", {})
+        monkeypatch.setattr(scheduler.device_store, "load", lambda: {"devices": {"synthetic": {"config": {}}}})
+        monkeypatch.setattr(scheduler.log_store, "device_entries", lambda _device: {"active": [], "legacy": []})
+        entered = asyncio.Event()
+        release = asyncio.Event()
+
+        async def active_operation():
+            async with scheduler.device_operation("synthetic"):
+                entered.set()
+                await release.wait()
+
+        active = asyncio.create_task(active_operation())
+        await entered.wait()
+        deleting = asyncio.create_task(scheduler.prepare_device_deletion("synthetic"))
+        await asyncio.sleep(0)
+        assert scheduler.is_device_deleted("synthetic")
+        assert not deleting.done()
+        rejected = False
+        try:
+            async with scheduler.device_operation("synthetic"):
+                pass
+        except RuntimeError:
+            rejected = True
+        assert rejected
+        release.set()
+        await active
+        _entry, lock = await deleting
+        assert lock.locked()
+        lock.release()
+
+    asyncio.run(scenario())
+
+
+def test_cancelled_scheduled_forward_waits_for_started_thread():
+    import threading
+
+    async def scenario():
+        started = threading.Event()
+        release = threading.Event()
+
+        def blocking_send():
+            started.set()
+            release.wait(timeout=5)
+            return "finished"
+
+        task = asyncio.create_task(scheduler._uncancellable_thread(blocking_send))
+        for _ in range(100):
+            if started.is_set():
+                break
+            await asyncio.sleep(0.01)
+        assert started.is_set()
+        task.cancel()
+        await asyncio.sleep(0.02)
+        assert not task.done()
+        release.set()
+        try:
+            await task
+            assert False, "cancelled work must re-raise cancellation after the send finishes"
+        except asyncio.CancelledError:
+            pass
+
+    asyncio.run(scenario())
+
