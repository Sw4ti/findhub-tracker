+def device_entries(canonic_id: str) -> dict:
+    """Snapshot all per-device forwarding log records before destructive cleanup."""
+    if demo_mode.is_demo_mode():
+        return {"active": [], "legacy": []}
+    with _lock:
+        active = [entry for entry in _read_all() if entry.get("canonic_id") == canonic_id]
+        legacy_entries = []
+        path = config.FORWARD_LOG_LEGACY_JSON_PATH
+        if path.is_file() and not path.is_symlink():
+            try:
+                with path.open(encoding="utf-8") as stream:
+                    data = json.load(stream)
+                entries = data.get("entries") if isinstance(data, dict) else None
+                if isinstance(entries, list):
+                    legacy_entries = [entry for entry in entries if isinstance(entry, dict)
+                                      and entry.get("canonic_id") == canonic_id]
+            except (OSError, json.JSONDecodeError):
+                raise RuntimeError("Legacy forwarding history could not be read safely")
+        return {"active": active, "legacy": legacy_entries}
+
+
+def remove_device(canonic_id: str) -> int:
+    """Atomically remove a device's log entries from active and legacy files."""
+    if demo_mode.is_demo_mode():
+        return 0
+    with _lock:
+        entries = _read_all()
+        kept = [entry for entry in entries if entry.get("canonic_id") != canonic_id]
+        removed = len(entries) - len(kept)
+        if removed:
+            _write_all(kept)
+        legacy = config.FORWARD_LOG_LEGACY_JSON_PATH
+        if legacy.is_file() and not legacy.is_symlink():
+            try:
+                with legacy.open(encoding="utf-8") as stream:
+                    old = json.load(stream)
+                old_entries = old.get("entries") if isinstance(old, dict) else None
+                if isinstance(old_entries, list):
+                    retained = [entry for entry in old_entries
+                                if not isinstance(entry, dict) or entry.get("canonic_id") != canonic_id]
+                    if len(retained) != len(old_entries):
+                        old["entries"] = retained
+                        temporary = legacy.with_suffix(legacy.suffix + ".tmp")
+                        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+                        with os.fdopen(fd, "w", encoding="utf-8") as stream:
+                            json.dump(old, stream, separators=(",", ":"))
+                            stream.flush()
+                            os.fsync(stream.fileno())
+                        os.replace(temporary, legacy)
+                        os.chmod(legacy, 0o600)
+                        removed += len(old_entries) - len(retained)
+            except (OSError, json.JSONDecodeError):
+                raise RuntimeError("Legacy forwarding history could not be safely cleaned")
+        return removed
+
+
+def restore_device(canonic_id: str, snapshots: dict):
+    """Restore saved log records after a failed cross-service deletion."""
+    if demo_mode.is_demo_mode():
+        return
+    if not isinstance(snapshots, dict):
+        raise ValueError("Forwarding-log recovery state is invalid")
+    with _lock:
+        active = snapshots.get("active", [])
+        entries = _read_all()
+        entries = [entry for entry in entries if entry.get("canonic_id") != canonic_id]
+        entries.extend(entry for entry in active if isinstance(entry, dict) and entry.get("canonic_id") == canonic_id)
+        _write_all(sorted(entries, key=lambda item: item.get("time", 0)))
+        legacy_entries = snapshots.get("legacy", [])
+        path = config.FORWARD_LOG_LEGACY_JSON_PATH
+        if legacy_entries and path.is_file() and not path.is_symlink():
+            with path.open(encoding="utf-8") as stream:
+                old = json.load(stream)
+            current = old.get("entries") if isinstance(old, dict) else None
+            if not isinstance(current, list):
+                raise RuntimeError("Legacy forwarding log has an unsupported structure")
+            current = [entry for entry in current
+                       if not isinstance(entry, dict) or entry.get("canonic_id") != canonic_id]
+            old["entries"] = current + [entry for entry in legacy_entries
+                                        if isinstance(entry, dict) and entry.get("canonic_id") == canonic_id]
+            temporary = path.with_suffix(path.suffix + ".tmp")
+            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+            with os.fdopen(fd, "w", encoding="utf-8") as stream:
+                json.dump(old, stream, separators=(",", ":"))
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temporary, path)
+            os.chmod(path, 0o600)
