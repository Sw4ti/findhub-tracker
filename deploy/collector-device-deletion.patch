diff --git a/webui/routers/findhub_deletion.py b/webui/routers/findhub_deletion.py
new file mode 100644
index 0000000..90d5c6f
--- /dev/null
+++ b/webui/routers/findhub_deletion.py
@@ -0,0 +1,160 @@
+"""Internal tracker-only deletion bridge; never exposed through the dashboard."""
+import hmac
+import json
+import os
+import re
+import uuid
+from pathlib import Path
+
+from fastapi import APIRouter, Header, HTTPException
+from pydantic import BaseModel, Field
+
+from webui import config, scheduler
+
+router = APIRouter(prefix="/internal/tracker/devices")
+_TOKEN = os.environ.get("FINDHUB_DELETION_TOKEN", "")
+
+class Operation(BaseModel):
+    operation_id: str = Field(min_length=36, max_length=36)
+
+class RestoreOperation(Operation):
+    entry: dict | None = None
+
+def _authorized(value: str):
+    if not _TOKEN or not hmac.compare_digest(value, _TOKEN):
+        raise HTTPException(401, "Unauthorized")
+
+def _operation(value: str) -> str:
+    try:
+        return str(uuid.UUID(value))
+    except (ValueError, AttributeError) as error:
+        raise HTTPException(422, "Invalid operation identifier") from error
+
+def _device(value: str) -> str:
+    if not re.fullmatch(r"[A-Za-z0-9._:-]{1,200}", value):
+        raise HTTPException(422, "Invalid stable device identifier")
+    return value
+
+def _journal_dir() -> Path:
+    root = config.DATA_DIR / ".findhub-device-deletion"
+    root.mkdir(mode=0o700, parents=True, exist_ok=True)
+    os.chmod(root, 0o700)
+    return root
+
+def _journal_path(op: str) -> Path:
+    return _journal_dir() / (op + ".json")
+
+def _write_journal(op: str, device: str, entry: dict):
+    target = _journal_path(op)
+    if target.exists() or target.is_symlink():
+        with target.open(encoding="utf-8") as stream:
+            saved = json.load(stream)
+        if saved.get("device_id") != device:
+            raise RuntimeError("Deletion journal identity mismatch")
+        return saved["entry"]
+    temp = target.with_suffix(".tmp")
+    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as stream:
+            json.dump({"operation_id": op, "device_id": device, "entry": entry}, stream,
+                      separators=(",", ":"), sort_keys=True)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temp, target)
+        os.chmod(target, 0o600)
+        dirfd = os.open(target.parent, os.O_RDONLY)
+        try:
+            os.fsync(dirfd)
+        finally:
+            os.close(dirfd)
+        return entry
+    finally:
+        try:
+            temp.unlink()
+        except FileNotFoundError:
+            pass
+
+def _read_journal(op: str, device: str) -> dict | None:
+    path = _journal_path(op)
+    if not path.exists():
+        return None
+    if path.is_symlink() or path.stat().st_mode & 0o077:
+        raise RuntimeError("Deletion journal permissions are unsafe")
+    with path.open(encoding="utf-8") as stream:
+        data = json.load(stream)
+    if data.get("operation_id") != op or data.get("device_id") != device or not isinstance(data.get("entry"), dict):
+        raise RuntimeError("Deletion journal is invalid")
+    return data["entry"]
+
+@router.post("/{canonic_id}/prepare")
+async def prepare(canonic_id: str, body: Operation, authorization: str = Header(default="", alias="X-FindHub-Deletion-Token")):
+    _authorized(authorization)
+    device = _device(canonic_id)
+    op = _operation(body.operation_id)
+    try:
+        entry, lock = await scheduler.prepare_device_deletion(device)
+    except LookupError as error:
+        raise HTTPException(409, "Collector device state is unavailable") from error
+    try:
+        entry = _write_journal(op, device, entry)
+    except Exception as error:
+        try:
+            scheduler.restore_device_state(device, entry)
+            _journal_path(op).unlink(missing_ok=True)
+        except Exception as recovery_error:
+            raise HTTPException(503, "Collector deletion needs recovery; the device remains fenced") from recovery_error
+        raise HTTPException(503, "Collector state could not be removed safely") from error
+    finally:
+        lock.release()
+    return {"operation_id": op, "device_id": device, "entry": entry}
+
+@router.post("/{canonic_id}/delete")
+async def delete(canonic_id: str, body: Operation, authorization: str = Header(default="", alias="X-FindHub-Deletion-Token")):
+    _authorized(authorization)
+    device = _device(canonic_id)
+    op = _operation(body.operation_id)
+    entry = _read_journal(op, device)
+    if not isinstance(entry, dict):
+        raise HTTPException(409, "A verified recovery checkpoint must be prepared first")
+    try:
+        _current, lock = await scheduler.prepare_device_deletion(device)
+    except LookupError as error:
+        raise HTTPException(409, "Collector device state is unavailable") from error
+    try:
+        scheduler.commit_prepared_device_deletion(device, lock)
+    except Exception as error:
+        raise HTTPException(503, "Collector state could not be removed safely") from error
+    finally:
+        lock.release()
+    await scheduler.ws.manager.broadcast({"type": "device_removed", "canonic_id": device})
+    return {"operation_id": op, "device_id": device, "entry": entry}
+
+@router.post("/{canonic_id}/restore")
+async def restore(canonic_id: str, body: RestoreOperation, authorization: str = Header(default="", alias="X-FindHub-Deletion-Token")):
+    _authorized(authorization)
+    device = _device(canonic_id)
+    op = _operation(body.operation_id)
+    entry = body.entry or _read_journal(op, device)
+    if not isinstance(entry, dict) or not isinstance(entry.get("device_state"), dict):
+        raise HTTPException(409, "No recoverable collector deletion state exists")
+    scheduler.restore_device_state(device, entry)
+    _journal_path(op).unlink(missing_ok=True)
+    return {"operation_id": op, "device_id": device, "restored": True}
+
+@router.post("/{canonic_id}/commit")
+async def commit(canonic_id: str, body: Operation, authorization: str = Header(default="", alias="X-FindHub-Deletion-Token")):
+    _authorized(authorization)
+    device = _device(canonic_id)
+    op = _operation(body.operation_id)
+    path = _journal_path(op)
+    if path.exists():
+        _read_journal(op, device)
+        path.unlink()
+    return {"operation_id": op, "device_id": device, "committed": True}
+
+@router.post("/{canonic_id}/revive")
+async def revive(canonic_id: str, authorization: str = Header(default="", alias="X-FindHub-Deletion-Token")):
+    _authorized(authorization)
+    device = _device(canonic_id)
+    scheduler.revive_device(device)
+    return {"device_id": device, "revived": True}
